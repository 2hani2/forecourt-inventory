# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
DATABASE_PATH=./data/forecourt.sqlite
PORT=3001
# Only used by npm run seed. Set your own password before seeding.
ADMIN_EMAIL=admin@forecourt.local
ADMIN_PASSWORD=replace-with-your-own-password
